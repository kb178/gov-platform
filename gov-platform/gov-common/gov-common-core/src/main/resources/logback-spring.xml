<?xml version="1.0" encoding="UTF-8"?>
<!--
    logback-spring.xml 日志配置文件

    作用：配置日志输出格式、输出位置、切割规则等

    配置说明：
    1. 控制台输出：开发时在控制台看日志
    2. 文件输出：日志保存到文件，重启后还在
    3. 按天切割：一天一个文件，方便查找
    4. 日志归档：保留最近 30 天，自动删除旧日志
    5. 分级别存储：ERROR 单独存储，快速定位问题
-->
<configuration scan="true" scanPeriod="10 seconds">

    <!-- ==================== 配置变量 ==================== -->
    <!--
        LOG_PATH：日志存储路径
        - 优先读取环境变量 LOG_PATH
        - 如果没有，使用默认值 ./logs
        - 生产环境可以通过环境变量指定：/var/log/gov-platform
    -->
    <property name="LOG_PATH" value="${LOG_PATH:-${user.home}/logs/gov-platform}"/>

    <!--
        APP_NAME：应用名称
        - 使用 springProperty 从 Spring 配置中读取
        - scope="context"：从 Spring Context 读取
        - defaultValue：读取失败时的默认值
    -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="gov-platform"/>

    <!--
        LOG_PATTERN：日志输出格式
        %d{yyyy-MM-dd HH:mm:ss.SSS} - 时间（精确到毫秒）
        [%level]                     - 日志级别（INFO、WARN、ERROR）
        [%thread]                    - 线程名
        %logger{36}                  - 类名（最多36个字符）
        %line                        - 行号
        %msg                         - 日志消息
        %n                           - 换行
    -->
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%level] [%thread] %logger{36}:%line - %msg%n"/>

    <!-- ==================== 控制台输出 ==================== -->
    <!--
        作用：开发时在控制台看日志
        只在非生产环境生效（通过 Spring Profile 控制）
    -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ==================== INFO 级别文件输出 ==================== -->
    <!--
        作用：记录 INFO、WARN、ERROR 级别的日志
        文件位置：./logs/gov-system/info.log
        切割规则：按天切割，单文件最大 50MB
        保留时间：30 天
    -->
    <appender name="INFO_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 当前日志文件 -->
        <file>${LOG_PATH}/${APP_NAME}/info.log</file>

        <!-- 过滤器：只记录 INFO 及以上级别 -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>INFO</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>NEUTRAL</onMismatch>
        </filter>

        <!-- 滚动策略 -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 归档文件名：info.2026-08-01.0.log -->
            <fileNamePattern>${LOG_PATH}/${APP_NAME}/info.%d{yyyy-MM-dd}.%i.log</fileNamePattern>

            <!-- 单文件最大 50MB -->
            <maxFileSize>50MB</maxFileSize>

            <!-- 保留 30 天 -->
            <maxHistory>30</maxHistory>

            <!-- 总大小限制 1GB -->
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ==================== WARN 级别文件输出 ==================== -->
    <!--
        作用：记录 WARN 级别的日志
        文件位置：./logs/gov-system/warn.log
    -->
    <appender name="WARN_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}/warn.log</file>

        <!-- 过滤器：只记录 WARN 级别 -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>WARN</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${APP_NAME}/warn.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ==================== ERROR 级别文件输出 ==================== -->
    <!--
        作用：只记录 ERROR 级别的日志
        文件位置：./logs/gov-system/error.log
        这个文件很重要！出问题时首先看这个文件
    -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${APP_NAME}/error.log</file>

        <!-- 过滤器：只记录 ERROR 级别 -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${APP_NAME}/error.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ==================== 日志级别配置 ==================== -->
    <!--
        作用：设置不同包的日志级别

        com.haikou.government：项目代码，使用 INFO 级别
        org.springframework：Spring 框架，使用 WARN 级别（减少日志）
        com.alibaba.cloud：Spring Cloud Alibaba，使用 WARN 级别
    -->
    <logger name="com.haikou.government" level="INFO"/>
    <logger name="org.springframework" level="WARN"/>
    <logger name="com.alibaba.cloud" level="WARN"/>

    <!-- ==================== 根日志配置 ==================== -->
    <!--
        root：所有日志的默认配置
        level="INFO"：默认记录 INFO 及以上级别
        ref：引用上面定义的 appender
    -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="INFO_FILE"/>
        <appender-ref ref="WARN_FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>

</configuration>
